{
  "name": "gainerinteractive/ig-trading-journal",
  "description": "Private WordPress investment tracker",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "ext-bcmath": "*"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "@php tests/run.php",
    "check-cs": "@php vendor/bin/phpcs",
    "fix-cs": "@php vendor/bin/phpcbf"
  }
}
